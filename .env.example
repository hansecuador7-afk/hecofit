# URL del proyecto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública del proyecto (anon o publishable). NUNCA uses service_role.
VITE_SUPABASE_ANON_KEY=tu_clave_publica

# Ruta base para GitHub Pages. Para el repositorio "hecofit" usar /hecofit/
VITE_BASE_PATH=/
